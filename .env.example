# Local development only. The packaged app stores keys via Settings → API keys (clickify.env in app user data).
CARTESIA_API_KEY=your-cartesia-key-here
OPENROUTER_API_KEY=sk-or-v1-...your-key-here
GEMINI_API_KEY=your-gemini-key-here

# LLM_PROVIDER: openrouter (default, uses google/gemini-2.5-flash) | gemini (use gemini-2.0-flash)
LLM_PROVIDER=openrouter
